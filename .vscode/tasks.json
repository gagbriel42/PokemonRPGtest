{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build real HGSS assets",
      "type": "shell",
      "command": "npm run hgss:build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Build real HGSS assets (auto)",
      "type": "shell",
      "command": "npm run hgss:build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      }
    }
  ]
}
